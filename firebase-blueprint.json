{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["uid"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Bookmarked GitHub repository",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "repoId": {
          "type": "number"
        },
        "fullName": {
          "type": "string",
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "htmlUrl": {
          "type": "string",
          "maxLength": 500
        },
        "stars": {
          "type": "number"
        },
        "forks": {
          "type": "number"
        },
        "language": {
          "type": "string",
          "maxLength": 50
        },
        "ownerLogin": {
          "type": "string",
          "maxLength": 100
        },
        "ownerAvatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "userId", "repoId", "fullName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public user profile and settings"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "Saved repository bookmarks"
    }
  }
}
